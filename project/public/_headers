/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # Cross-Origin-Opener-Policy: same-origin
  # Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# NOTE: COOP/COEP headers above are COMMENTED for Phase 1.
# They will be activated in the FFmpeg.wasm phase, where they are required
# for SharedArrayBuffer (used by FFmpeg.wasm and WebGPU threads). Leaving
# them active now could block downloads of models and external resources
# in upcoming phases, so they are intentionally disabled here.
